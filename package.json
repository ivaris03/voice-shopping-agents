{
  "name": "voice-shopping-agents",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:user": "pnpm --filter @voice-shopping/user-web dev",
    "dev:merchant": "pnpm --filter @voice-shopping/merchant-web dev",
    "dev:platform": "pnpm --filter @voice-shopping/platform-web dev",
    "dev:api": "uv run --project apps/api python -m voice_shopping_api.server --reload --port 8000",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:api": "uv run --project apps/api pytest",
    "lint:api": "uv run --project apps/api ruff check .",
    "format:api": "uv run --project apps/api ruff format ."
  }
}
