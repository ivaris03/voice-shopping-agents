# Copy this file to /opt/voice-shopping-agents/.env on the server.
# Use a URL-safe password because it is included in the PostgreSQL URLs below.
POSTGRES_DB=voice_shopping_agents
POSTGRES_USER=voice_shopping
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

VOICE_SHOPPING_ENVIRONMENT=production
VOICE_SHOPPING_DATABASE_URL=postgresql+asyncpg://voice_shopping:replace-with-openssl-rand-hex-32@postgres:5432/voice_shopping_agents
VOICE_SHOPPING_REDIS_URL=redis://redis:6379/0
VOICE_SHOPPING_CORS_ORIGINS=https://voice.ivaris.top,https://merchant.ivaris.top,https://platform.ivaris.top
VOICE_SHOPPING_JWT_SECRET=replace-with-a-long-random-secret
VOICE_SHOPPING_JWT_ISSUER=voice-shopping-api
VOICE_SHOPPING_JWT_AUDIENCE=voice-shopping-web
VOICE_SHOPPING_JWT_ACCESS_TOKEN_TTL_MINUTES=120

VOICE_SHOPPING_LANGGRAPH_CHECKPOINT_ENABLED=true
VOICE_SHOPPING_LANGGRAPH_CHECKPOINT_INIT_TIMEOUT_SECONDS=5
VOICE_SHOPPING_LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://voice_shopping:replace-with-openssl-rand-hex-32@postgres:5432/voice_shopping_agents
VOICE_SHOPPING_CATALOG_CACHE_ENABLED=true
VOICE_SHOPPING_CATALOG_CACHE_REDIS_URL=redis://redis:6379/0
VOICE_SHOPPING_LOG_LEVEL=INFO

DASHSCOPE_API_KEY=replace-with-dashscope-key
VOICE_SHOPPING_AGENT_MODEL=qwen3.7-flash
VOICE_SHOPPING_EMBEDDING_MODEL=qwen3.7-text-embedding
VOICE_SHOPPING_RERANKER_MODEL=qwen3-rerank
VOICE_SHOPPING_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
VOICE_SHOPPING_TTS_MODEL=qwen-audio-3.0-tts-plus
VOICE_SHOPPING_TTS_VOICE=longanlingxin

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voice-shopping-agents
LANGSMITH_TRACING=false
