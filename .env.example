# API
VOICE_SHOPPING_ENVIRONMENT=development
VOICE_SHOPPING_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice-shopping-agents
# E2E only. This must be a disposable database distinct from the application database.
VOICE_SHOPPING_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice-shopping-agents-test
VOICE_SHOPPING_REDIS_URL=redis://localhost:6379/0
# 分类与槽位快照在 Redis 中的保留时间；平台 taxonomy 写入成功后会立即失效。
VOICE_SHOPPING_TAXONOMY_CACHE_TTL_SECONDS=900
VOICE_SHOPPING_LANGGRAPH_CHECKPOINT_ENABLED=true
# 留空时复用 VOICE_SHOPPING_DATABASE_URL，并自动转换为 PostgreSQL checkpoint 连接串。
VOICE_SHOPPING_LANGGRAPH_CHECKPOINT_DATABASE_URL=
POSTGRES_PORT=5432
REDIS_PORT=6379
VOICE_SHOPPING_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
VOICE_SHOPPING_LOG_LEVEL=INFO

# Frontends
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_TEXT_WS_URL=ws://localhost:8000/ws/text
VITE_AUDIO_WS_URL=ws://localhost:8000/ws/audio
VITE_MERCHANT_WEB_URL=http://localhost:5174/
VITE_PLATFORM_WEB_URL=http://localhost:5175/

# Model integrations (optional; deterministic/browser fallbacks remain available)
DASHSCOPE_API_KEY=
VOICE_SHOPPING_DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VOICE_SHOPPING_DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VOICE_SHOPPING_AGENT_MODEL=qwen3.7-flash
VOICE_SHOPPING_EMBEDDING_MODEL=qwen3.7-text-embedding
VOICE_SHOPPING_RERANKER_MODEL=qwen3-rerank
VOICE_SHOPPING_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
VOICE_SHOPPING_TTS_MODEL=qwen-audio-3.0-tts-plus
VOICE_SHOPPING_TTS_VOICE=longanlingxin
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voice-shopping-agents
LANGSMITH_TRACING=true
